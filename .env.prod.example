# Copy to .env.prod and fill in. NEVER commit .env.prod.
#   cp .env.prod.example .env.prod

# Database (Postgres) — pick strong values.
DB_USER=kidscard
DB_PASSWORD=CHANGE_ME_db_password

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_password

# Shared HMAC secret used to sign/verify JWTs across ALL services.
# Must be the SAME everywhere and at least 32 chars. Generate e.g.:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_chars_shared_jwt_secret

# Cloudflare Tunnel token (from a *named* tunnel in the Zero Trust dashboard).
# The tunnel's ingress should route your hostname -> http://web:3000.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_cloudflare_tunnel_token
