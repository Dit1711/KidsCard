# Copy to .env.prod and fill in. NEVER commit .env.prod.
#   cp .env.prod.example .env.prod

# Database (Postgres) — pick strong values.
DB_USER=kidscard
DB_PASSWORD=CHANGE_ME_db_password

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_password

# Shared HMAC secret used to sign/verify JWTs across ALL services.
# Must be the SAME everywhere and at least 32 chars. Generate e.g.:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_chars_shared_jwt_secret

# Public domain (A-record must point at this server). Caddy gets HTTPS for it.
DOMAIN=kidscard.uz

# Password gate for the test site (HTTP basic auth).
BASIC_AUTH_USER=admin
# bcrypt hash of your password — generate with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'YourPassword'
# Paste the whole $2a$... line here (keep it exactly as printed).
BASIC_AUTH_HASH=CHANGE_ME_bcrypt_hash
